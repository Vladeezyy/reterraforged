{
  "schemaVersion": 1,
  "id": "reterraforged",
  "version": "${version}",
  "name": "ReTerraForged",
  "description": "Terrain generation for Minecraft ${minecraft_version} with configurable archipelagos, island mountains and volcanoes, adjustable island coasts and beaches, and corrected island biome routing.",
  "authors": [
	"dags",
	"Won-Ton",
	"racconman"
  ],
  "contact": {
    "repo": "https://github.com/Vladeezyy/reterraforged",
    "issues": "https://github.com/Vladeezyy/reterraforged/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "raccoonman.reterraforged.fabric.RTFFabric"
    ],
    "fabric-datagen": [
      "raccoonman.reterraforged.fabric.RTFFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16",
    "fabric-api": ">=${fabric_api_min}",
    "minecraft": "${minecraft_range_fabric}"
  },
  "mixins": [
    "reterraforged-common.mixins.json",
    "reterraforged-fabric.mixins.json"
  ],
  "icon": "assets/reterraforged/icon.png"
}
